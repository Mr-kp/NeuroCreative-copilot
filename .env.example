# ─── NeuroCreative Copilot — Settings ──────────────────────────────
# Copy this file to .env and edit.
# All keys are OPTIONAL — the app works with rule-based fallbacks.

# ─── LLM Provider ──────────────────────────────────────────────────
# Which service to use: "openai", "google", or leave empty for rule-based
LLM_PROVIDER=openai

# Model name (per provider):
#   openai:  gpt-4o, gpt-4o-mini, o3-mini, etc.
#   google:  gemini-2.0-flash, gemma-3-27b-it, etc.
LLM_MODEL=gpt-4o

# ─── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Google AI (Gemini / Gemma) ───────────────────────────────────
GOOGLE_API_KEY=

# ─── TRIBE v2 brain model ─────────────────────────────────────────
# Remote GPU endpoint from Colab/Kaggle. Empty = mock brain scores.
TRIBE_ENDPOINT=
TRIBE_TIMEOUT=30
